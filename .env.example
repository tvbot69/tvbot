# Database (append ?connection_limit=5&pool_timeout=20 when pooled, e.g. PgBouncer)
DATABASE_URL="postgresql://user:password@localhost:5432/tvbot"
# Optional direct (unpooled) URL for `prisma migrate deploy`. Only set this if
# you also add `directUrl = env("DIRECT_URL")` to schema.prisma — otherwise leave unset.
# DIRECT_URL="postgresql://user:password@localhost:5432/tvbot"

# Last.fm API
LASTFM_API_KEY="your_lastfm_api_key_here"
LASTFM_API_SECRET="your_lastfm_api_secret_here"

# Discord Bot Token
DISCORD_TOKEN="your_discord_bot_token_here"

# Spotify API (Optional/Required for artwork & Spotify links)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Discord Channel for temporary staging uploads (charts/images)
STAGING_CHANNEL_ID=""

# Genius API (Lyrics)
GENIUS_CLIENT_ID=""
GENIUS_CLIENT_SECRET=""
GENIUS_CLIENT_ACCESS_TOKEN=""

# Music Recognition (AuDD) & APIs
AUDD_API_TOKEN=""
YOUTUBE_API_KEY=""
DISCOGS_KEY=""
DISCOGS_SECRET=""

# Football API
API_FOOTBALL_KEY=""

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Lavalink Audio Nodes (Optional in dev)
ENABLE_LAVALINK=false
# Custom nodes (JSON array, unshifted ahead of built-in publics):
# LAVALINK_NODES='[{"identifier":"Self","host":"1.2.3.4","port":2333,"password":"youshallnotpass","secure":false}]'

# Home node (self-hosted Lavalink, e.g. Tailscale Funnel). Listed first =
# preferred while healthy; publics stay as automatic fallback.
# HOME_LAVALINK_URL="https://<machine>.<tailnet>.ts.net"
# HOME_LAVALINK_PASSWORD="youshallnotpass"
# HOME_LAVALINK_SECURE=true
# HOME_NODE_ENABLED=true

# Home yt-dlp resolver (primary playback path on Home). Both required.
# HOME_RESOLVER_URL="https://<machine>.<tailnet>.ts.net:8443"
# HOME_RESOLVER_TOKEN="<server RESOLVER_TOKEN, exact bytes>"
# Plugin rung on Home is OFF by default (never produced audio; each attempt
# costs dead air). Restore only after a verified youtube-source fix:
# HOME_PLUGIN_RUNG=on

# Resolver breakage alerts: private Discord webhook for 30%+ 502s over the
# last 10+ calls or 3+ unreachable pauses/hour (30-min cooldown per rule).
# Unset = silent, ladder still degrades to SoundCloud on its own.
# RESOLVER_ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Sharding (single-process default; enable past ~2,000 guilds)
# SHARDING_ENABLED=false
# SHARD_COUNT=

# Fatal-error feed: private Discord channel webhook URL (free forever, no
# accounts). Unset = errors stay in Railway logs only.
# ERROR_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Skip global slash-command registration on boot (CI deploys them instead)
# SKIP_SLASH_REGISTER=false

# Environment
ENVIRONMENT=development
