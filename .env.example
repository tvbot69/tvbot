# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tvbot"

# Last.fm API
LASTFM_API_KEY="your_lastfm_api_key_here"
LASTFM_API_SECRET="your_lastfm_api_secret_here"

# Discord Bot Token
DISCORD_TOKEN="your_discord_bot_token_here"

# Spotify API (Optional/Required for artwork & Spotify links)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Discord Channel for temporary staging uploads (charts/images)
STAGING_CHANNEL_ID=""

# Genius API (Lyrics)
GENIUS_CLIENT_ID=""
GENIUS_CLIENT_SECRET=""
GENIUS_CLIENT_ACCESS_TOKEN=""

# Music Recognition (AuDD) & APIs
AUDD_API_TOKEN=""
YOUTUBE_API_KEY=""
DISCOGS_KEY=""
DISCOGS_SECRET=""

# Football API
API_FOOTBALL_KEY=""

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Lavalink Audio Nodes (Optional in dev)
ENABLE_LAVALINK=false

# Environment
ENVIRONMENT=development
