# Dependencies
node_modules/

# Production build
dist/

# Environment files and credentials (NEVER commit secrets!)
.env
.env.*
!.env.example

# Local backups and external repos
backup/
fmbot-dev/

# Local cache, browser data, and scratch scripts
scratch/
.gemini/
# Ignore .opencode contents (node_modules, local tooling state) but keep the
# tracked skill. A trailing slash here would exclude the directory itself and
# git would never descend to re-include the file.
.opencode/*
!.opencode/skills/
!.opencode/skills/tvbot/
!.opencode/skills/tvbot/SKILL.md
.moonlink/
.puppeteer/
.run/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test coverage
coverage/

# OS-specific
.DS_Store
Thumbs.db

# Local audit artifacts (one session, not project files).
# Named specifically rather than with a blanket `*.md` / `*.txt`: this repo
# TRACKS markdown (AGENTS.md, docs/*.md, .opencode/skills/**/SKILL.md) and
# blanket rules do not apply retroactively, so they would hide new files while
# leaving the old ones tracked - the worst of both.
A1-HANDOFF.md
full*.txt
Screenshot_*.png
